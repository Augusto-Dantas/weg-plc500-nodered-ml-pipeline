{attribute 'qualified_only'}
VAR_GLOBAL
  (* ===================================================================== *)
  (* 1. E/S Fisicas Nativas - WEG PLC500 Local_IO (24 Vcc PNP)             *)
  (* ===================================================================== *)
  xRaw_DI0_Presenca   AT %IX0.0 : BOOL;          (* B1_SensPresenca - Contato NA *)
  xRaw_DI1_NivelAlto  AT %IX0.1 : BOOL;          (* B2_SensNivelAlto - Contato NA *)
  xRaw_DI2_Sobretemp  AT %IX0.2 : BOOL;          (* B3_SensSobretemp - Contato NA *)
  xRaw_DI3_Emergencia AT %IX0.3 : BOOL;          (* B4_Emergencia - Contato NF fail-safe (FALSE = emerg./fio partido) *)

  xDO0_Motor          AT %QX0.0 : BOOL := FALSE; (* L1_AtuMotor - LED Verde *)
  xDO1_Valvula        AT %QX0.1 : BOOL := FALSE; (* L2_AtuValvula - LED Amarelo *)
  xDO2_Alarme         AT %QX0.2 : BOOL := FALSE; (* L3_SinalAlarme - LED Vermelho *)
  xDO3_StatusOper     AT %QX0.3 : BOOL := FALSE; (* L4_StatusOper - LED Branco *)

  (* ===================================================================== *)
  (* 2. Discrete Inputs - Modbus FC02 (Enderecos base zero 0..5)           *)
  (* ===================================================================== *)
  xDI_Presenca : BOOL := FALSE; (* DI[0]: Estado filtrado (TON 50 ms) de B1_SensPresenca *)
  xDI_NivelAlto : BOOL := FALSE; (* DI[1]: Estado filtrado (TON 50 ms) de B2_SensNivelAlto *)
  xDI_Sobretemp : BOOL := FALSE; (* DI[2]: Estado filtrado (TON 50 ms) de B3_SensSobretemp *)
  xDI_EmergenciaOK : BOOL := TRUE; (* DI[3]: Estado imediato NF de B4_Emergencia (TRUE em repouso; FALSE = emergencia) *)
  xFlag_EmergTravada : BOOL := FALSE; (* DI[4]: 1 = emergencia travada aguardando rearme seguro *)
  xFlag_WatchdogAtivo : BOOL := FALSE; (* DI[5]: 1 = heartbeat estagnado > uiTimeout_WD_ms *)

  (* ===================================================================== *)
  (* 3. Coils - Modbus FC01/05/15 (Enderecos base zero 0..4)               *)
  (* ===================================================================== *)
  xCmd_Motor : BOOL := FALSE; (* Coil[0]: Comando remoto para L1_AtuMotor (DO0) *)
  xCmd_Valvula : BOOL := FALSE; (* Coil[1]: Comando remoto para L2_AtuValvula (DO1) *)
  xCmd_Alarme : BOOL := FALSE; (* Coil[2]: Comando remoto para L3_SinalAlarme (DO2) *)
  xCmd_ResetFalha : BOOL := FALSE; (* Coil[3]: Pulso de rearme (borda de subida; valido se DI3=1 e DI2=0) *)
  xCmd_HabRemoto : BOOL := FALSE; (* Coil[4]: 1 = habilita modo automatico supervisionado *)

  (* ===================================================================== *)
  (* 4. Input Registers - Modbus FC04 (Enderecos base zero 0..7)           *)
  (* ===================================================================== *)
  uiCnt_Presenca : UINT := 0; (* IR[0]: Contador modular 16 bits de B1 (0..65535) *)
  uiCnt_NivelAlto : UINT := 0; (* IR[1]: Contador modular 16 bits de B2 (0..65535) *)
  uiCnt_Sobretemp : UINT := 0; (* IR[2]: Contador modular 16 bits de B3 (0..65535) *)
  uiCnt_Emergencia : UINT := 0; (* IR[3]: Contador modular 16 bits de eventos em B4 (0..65535) *)
  uiEstado_CLP : UINT := 0; (* IR[4]: 0=INIT, 1=NORMAL_AUTO, 2=ALERTA, 3=MODO_DEGRADADO, 4=EMERGENCIA_TRAV *)
  wMascara_DO_Real : WORD := 0; (* IR[5]: Bitmask das saidas fisicas (bit0=DO0..bit3=DO3) *)
  uiEcho_Heartbeat : UINT := 0; (* IR[6]: Eco do ultimo valor de heartbeat recebido *)
  uiCod_Intertrav : UINT := 0; (* IR[7]: 0=Nenhum, 1=Emergencia, 2=Sobretemp, 3=Watchdog *)

  (* ===================================================================== *)
  (* 5. Holding Registers - Modbus FC03/06/16 (Enderecos base zero 0..3)   *)
  (* ===================================================================== *)
  uiHeartbeat_Sup : UINT := 0; (* HR[0]: Heartbeat ciclico 1..65535 (aliases de compatibilidade: uiHeartbeat_NR, uiHeartbeat_N8N) *)
  uiTimeout_WD_ms : UINT := 5000; (* HR[1]: Timeout do watchdog em ms [2000..30000], padrao 5000 *)
  uiSeveridade_IA : UINT := 0; (* HR[2]: 0=NORMAL, 1=ATENCAO, 2=CRITICO, 3=EMERGENCIA *)
  uiVersao_Mapa : UINT := 100; (* HR[3]: Versao fixa do contrato Modbus (100 = v1.0) *)
END_VAR
