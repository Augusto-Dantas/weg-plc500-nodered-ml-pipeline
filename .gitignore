# ==============================================================================
# .gitignore — weg-plc500-nodered-ml-pipeline
# ==============================================================================

# --- AI / Agent Local Metadata & Rules ---
GEMINI.md
.agents/

# --- Secrets, Credentials & Environment ---
.env
.env.*
*.env
!.env.example
*.key
*.pem
*.p12
*.pfx
*credentials*
flows_cred.json
!*.example
!*credentials*example*
!flows_cred.json.example

# --- Python / uv / ML / Test Caches ---
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
dist/
build/

# --- Node.js & Node-RED Runtime ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node-red/.config*.json
node-red/.sessions.json

# --- LaTeX Build Intermediates (keep .pdf, .tex, .bib, .zip tracked) ---
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.loq
*.lot
*.brf
*.idx
*.ilg
*.ind
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
hardware/latex/*.pdf

# --- KiCad Lock & Backup Files (keep .kicad_pro, .kicad_sch tracked) ---
~*.lck
*.kicad_sch-bak
*.kicad_pcb-bak
*-backups/

# --- OS & Editor Clutter ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
