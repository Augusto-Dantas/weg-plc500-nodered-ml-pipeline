# ==============================================================================
# .env.example — weg-plc500-nodered-ml-pipeline
# Copy to `.env` and replace CHANGE_ME_* placeholders before starting services.
# NEVER commit `.env` or real secrets to Git.
# ==============================================================================

# --- General ---
LOG_LEVEL=INFO
TZ=UTC

# --- OT / WEG PLC500 Modbus TCP Target (Technical Contract: ETH2) ---
# Physical WEG PLC500 ETH2 IP is 192.168.10.10.
# For Docker Compose `sim` profile, override to: plc-simulator
# For local non-Docker simulator, override to: 127.0.0.1
PLC_HOST=192.168.10.10
PLC_PORT=502
PLC_UNIT_ID=1
# Compatibility alias if referenced by scripts/nodes:
UNIT_ID=1
PLC_WATCHDOG_TIMEOUT_MS=5000
PLC_MODBUS_MAP_VERSION=100

# --- M3 Python PLC Simulator (`plc_simulator.py`, Compose profile: `sim`) ---
PLC_SIM_HOST=0.0.0.0
# Use 502 inside Docker container or 5020 when running locally without root
PLC_SIM_PORT=502
PLC_SIM_API_PORT=8001
# Use http://127.0.0.1:8001 outside Docker Compose
PLC_SIM_API_URL=http://plc-simulator:8001

# --- M4 PostgreSQL Persistence ---
# Use `postgres` in Docker Compose; `localhost` or `192.168.10.20` on bare-metal bench
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=plc500_telemetry
POSTGRES_USER=plc500_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- M3 FastAPI ML Inference Service (`ml-api`) ---
ML_API_HOST=0.0.0.0
ML_API_PORT=8000
# Use http://127.0.0.1:8000 outside Docker Compose
ML_API_URL=http://ml-api:8000
ML_MODELS_DIR=python/models
ML_WINDOW_SECONDS=60
ML_BASELINE_MU=12.0
ML_BASELINE_SIGMA=2.5
ML_ZSCORE_EPS=0.01

# --- M4 Node-RED Orchestrator & Dashboard ---
NR_PORT=1880
NR_ADMIN_USER=admin
NR_ADMIN_PASSWORD=CHANGE_ME_NODERED_ADMIN_PASSWORD
NR_CREDENTIAL_SECRET=CHANGE_ME_NODERED_CREDENTIAL_SECRET
# Polling & Hybrid Analysis timings from Technical Contract (Tp=500ms, W=60s)
NR_POLL_INTERVAL_MS=500
NR_ANALYSIS_INTERVAL_S=60
NR_MODBUS_TIMEOUT_MS=1500
NR_MODBUS_RECONNECT_MS=2000

# --- Optional Cognitive LLM Branch (Node-RED Tab 2) ---
# Options: none | ollama | openai
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Use http://127.0.0.1:11434 outside Docker Compose
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
# Must stay below CT-10 15s end-to-end SLA including fallback
LLM_TIMEOUT_MS=8000

# --- Optional Incident Report Notifications (CT-10) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
